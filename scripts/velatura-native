#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"
binary="$repo_root/target/debug/velatura"

if [[ -x "$binary" ]]; then
  exec "$binary" "$@"
fi

case "${1:-run}" in
  help|-h|--help)
    exec cargo run --quiet --manifest-path "$repo_root/Cargo.toml" --features gtk-app --bin velatura --jobs 1 -- help
    ;;
  version|--version|-V)
    version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$repo_root/Cargo.toml" | head -n 1)"
    printf 'Velatura %s (development launcher)\n' "$version"
    ;;
  *)
    exec cargo run --manifest-path "$repo_root/Cargo.toml" --features gtk-app --bin velatura --jobs 1 -- "$@"
    ;;
esac
